# Required: Get from @BotFather on Telegram
BOT_TOKEN=your_telegram_bot_token_here

# Required: Get from Google AI Studio (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Server port (default: 3000)
PORT=3000

# Optional: Number of worker goroutines (default: 4)
# For Pi Zero 2 W with 512MB RAM, use 2
WORKER_POOL_SIZE=2

# Optional: SQLite database path (default: ./data/prompts.db)
DATABASE_PATH=./data/prompts.db
